# ==============================================================================
# 云裳女装多 Agent 双域电商系统 - 环境变量配置示例 (.env.example)
# 使用方式：复制本文件为 `.env` 并按本地开发或容器生产环境按需修改
# ==============================================================================

# 1. 运行环境、结构化日志与持久化连接
# 可选值: dev | prod
APP_ENV=dev
LOG_LEVEL=INFO
# 本地开发留空默认使用内存态 MemorySaver + InMemoryAuditStore；
# 生产/Docker 环境填写 PostgreSQL 连接串启用 AsyncPostgresSaver + PostgresAuditStore：
# DATABASE_URL=postgresql://yunshang:yunshang_dev_pwd@127.0.0.1:5432/yunshang_open_market
DATABASE_URL=

# 2. API Gateway JWT 鉴权与跨域配置
# 生产环境请务必替换为高强度随机密钥（至少 32 位）
JWT_SECRET=change-me-in-production-yunshang-hs256-signing-secret-2026
JWT_ALGORITHM=HS256
JWT_ISSUER=oppo-ecommerce-agent-gateway
JWT_TTL_SECONDS=28800
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# 3. 大模型路由与降级配置
# 可选值: mock（确定性离线推理） | litellm（调用真实大模型）
LLM_MODE=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
# 多个备选模型使用英文逗号分隔，主模型超时或报错时按序自动降级重试
LLM_FALLBACK_MODELS=
LLM_FALLBACK_TO_MOCK=false
REQUIRE_ADDRESS_HITL=false

# 4. 五域独立 MCP Server 托管与连接端点
# 本地开发(APP_ENV=dev)默认为 true（由网关自动拉起并回收子进程）；
# 生产或 Docker Compose 部署(APP_ENV=prod)默认为 false（直接连接下方各独立容器端点）
MCP_SPAWN_LOCAL_SUBPROCESS=true

MCP_PIM_URL=http://127.0.0.1:18101/mcp
MCP_OMS_URL=http://127.0.0.1:18102/mcp
MCP_LOGISTICS_URL=http://127.0.0.1:18103/mcp
MCP_BI_URL=http://127.0.0.1:18104/mcp
MCP_MARKET_ERP_URL=http://127.0.0.1:18105/mcp

MCP_CLIENT_TIMEOUT_SECONDS=8.0
MCP_CLIENT_CONNECT_TIMEOUT_SECONDS=3.0
TOOL_RUNTIME_TIMEOUT_SECONDS=30.0

# 5. 可选可观测平台（Langfuse，未配置时零报错静默跳过）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
