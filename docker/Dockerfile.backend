# syntax=docker/dockerfile:1
# ==============================================================================
# 云裳女装多 Agent 双域电商系统 - 后端通用多阶段构建镜像 (docker/Dockerfile.backend)
# 同一镜像可通过不同 CMD 分别运行:
#   - API Gateway:  uvicorn gateway.main:app --host 0.0.0.0 --port 8000
#   - PIM MCP:      python -m mcp_servers.pim_server --host 0.0.0.0 --port 18101
#   - OMS MCP:      python -m mcp_servers.oms_server --host 0.0.0.0 --port 18102
#   - Logistics:    python -m mcp_servers.logistics_server --host 0.0.0.0 --port 18103
#   - BI MCP:       python -m mcp_servers.bi_server --host 0.0.0.0 --port 18104
#   - Market & ERP: python -m mcp_servers.market_erp_server --host 0.0.0.0 --port 18105
# ==============================================================================

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml ./
COPY config ./config
COPY infra ./infra
COPY gateway ./gateway
COPY agents ./agents
COPY runtime ./runtime
COPY mcp_servers ./mcp_servers
COPY schemas ./schemas

RUN pip install --upgrade pip setuptools wheel \
    && pip install ".[postgres,observability]"


FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 appgroup \
    && useradd --uid 10001 --gid appgroup --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=appuser:appgroup pyproject.toml ./
COPY --chown=appuser:appgroup config ./config
COPY --chown=appuser:appgroup infra ./infra
COPY --chown=appuser:appgroup gateway ./gateway
COPY --chown=appuser:appgroup agents ./agents
COPY --chown=appuser:appgroup runtime ./runtime
COPY --chown=appuser:appgroup mcp_servers ./mcp_servers
COPY --chown=appuser:appgroup schemas ./schemas

USER appuser

EXPOSE 8000

CMD ["uvicorn", "gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
